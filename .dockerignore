# Allow only runtime sources and package metadata into the build context.
**
!Dockerfile
!.dockerignore
!app.py
!requirements.txt
!pyproject.toml
!README.md
!src/
!src/**

# Also exclude generated files and secrets nested inside allowed sources.
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.venv
**/venv
**/.env
**/.env.*
**/.git
**/.streamlit
**/data
**/outputs
**/work
**/secrets
**/credentials
**/private
**/pii
**/local
**/uploads
**/results
**/logs
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.csv
**/*.tsv
**/*.xlsx
**/*.parquet
**/*.db
**/*.sqlite*
**/*.log
